+          -- Nat.min/Nat.max usually reach the proj/instance path instead of
+          -- here; extraction code that needs a provably-correct min should use
+          -- the explicit `if a ≤ b then a else b` form, which lowers cleanly.)
+          let valArgs := args.filter (fun a => match a with
